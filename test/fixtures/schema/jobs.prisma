enum JobState {
  queued
  running
  done
  failed
  cancelled

  @@map("job_state")
}

// Extras in the migrations: the partial index job_live_run_after_idx on (run_after, id),
// for jobs that aren't cancelled.
model Job {
  id        BigInt    @id @default(autoincrement())
  kind      String
  state     JobState  @default(queued)
  payload   Json      @default("{}")
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  claimedBy String?   @map("claimed_by")
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)

  @@map("job")
}
